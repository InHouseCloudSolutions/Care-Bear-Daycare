# Rover app API key. Copy this file to .env.local and set the value there.
# .env.local is gitignored. Do not prefix this with NEXT_PUBLIC_.
ROVER_API_KEY=

# Daycare (Care Bear) API origin used by the server-side /daycare-api/:path* rewrite
# in next.config.js. Server-side only — do not prefix with NEXT_PUBLIC_; the browser
# always calls the same-origin /daycare-api path, never this origin directly.
# Defaults to https://inhousecloudsolutions.com when unset.
DAYCARE_API_ORIGIN=
