# Rover app API key. Copy this file to .env.local and set the value there.
# .env.local is gitignored. Do not prefix this with NEXT_PUBLIC_.
ROVER_API_KEY=

# Daycare (Care Bear) API origin used by the server-side /daycare-api/:path* rewrite
# in next.config.js. Server-side only — do not prefix with NEXT_PUBLIC_; the browser
# always calls the same-origin /daycare-api path, never this origin directly.
# Defaults to https://inhousecloudsolutions.com when unset.
DAYCARE_API_ORIGIN=

# Set both to 1 to show the Local / Production API chip in development.
# A production build never shows the chip and always uses DAYCARE_API_ORIGIN.
# Local is the website Docker API. From the host, localhost:3033.
# From the Dog Hotel container, host.docker.internal:3033 (see docker-compose.yml).
# Restart Next after changing these. Flipping the chip itself does not need a restart.
DAYCARE_API_SWITCH=
NEXT_PUBLIC_DAYCARE_API_SWITCH=
DAYCARE_API_ORIGIN_LOCAL=http://localhost:3033
